diff --git a/css/style.css b/css/style.css
index 32e7e6a..0ef295d 100644
--- a/css/style.css
+++ b/css/style.css
@@ -1028,14 +1028,22 @@ legend + *{clear:both;}
 .route-fields{display:grid; grid-template-columns:1fr auto 1fr; gap:12px; align-items:end; margin-bottom:0;}
 .swap-btn{
   width:42px; height:42px; border-radius:50%; border:1px solid var(--line-strong);
-  background:var(--bg-2); color:var(--gold); font-size:1.1rem; cursor:pointer;
+  background:#fff; color:var(--gold); cursor:pointer; padding:0;
   display:flex; align-items:center; justify-content:center; flex-shrink:0;
-  transition:all .2s ease; margin-bottom:1px;
+  box-shadow:0 2px 8px rgba(7,38,76,0.10);
+  transition:background .2s ease, color .2s ease, box-shadow .2s ease; margin-bottom:1px;
 }
-.swap-btn:hover{background:var(--gold); color:#fff; transform:rotate(180deg);}
+/* Arrows point sideways while the two fields sit side by side. */
+.swap-btn svg{width:19px; height:19px; transform:rotate(90deg); transition:transform .3s var(--ease-out, ease);}
+.swap-btn:hover{background:var(--gold); color:#fff; box-shadow:0 4px 12px rgba(0,87,193,0.25);}
+.swap-btn:hover svg, .swap-btn:active svg{transform:rotate(270deg);}
 @media (max-width:640px){
   .route-fields{grid-template-columns:1fr; gap:8px;}
-  .swap-btn{justify-self:center; margin:4px 0;}
+  /* Fields are stacked: the button sits in the middle between them, half
+     over each, with the arrows pointing up and down. */
+  .swap-btn{justify-self:center; align-self:center; margin:-20px 0; position:relative; z-index:2; width:40px; height:40px;}
+  .swap-btn svg{transform:none;}
+  .swap-btn:hover svg, .swap-btn:active svg{transform:rotate(180deg);}
 }
 
 .custom-quote-msg{font-size:0.9rem; color:var(--gray); line-height:1.6; padding:8px 0;}
@@ -1568,9 +1576,8 @@ header.is-scrolled .brand-logo{transform:scale(.92);}
 @media (max-width:640px){
   .bw-compact{padding:20px 18px 22px;}
   .bw-compact .toggle-group{margin-bottom:16px;}
-  /* The swap button sits on the Dropoff label line instead of taking a row. */
   .bw-compact .route-fields{gap:10px;}
-  .bw-compact .swap-btn{justify-self:end; width:30px; height:30px; font-size:0.9rem; margin:-6px 4px -36px 0; position:relative; z-index:2;}
+  .bw-compact .swap-btn{width:38px; height:38px; margin:-19px 0;}
   .bw-compact .bw-dtp{grid-template-columns:minmax(0,1fr) minmax(0,1fr);}
   .bw-compact .bw-dtp .bw-pax{grid-column:1 / -1;}
   .bw-compact .vehicle-opt{grid-template-columns:18px minmax(0,1fr) auto; grid-template-areas:"dot name price" "dot model price" "dot pax price"; column-gap:12px;}

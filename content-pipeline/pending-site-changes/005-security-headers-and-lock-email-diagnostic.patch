diff --git a/_headers b/_headers
index bda869d..ce7ef2c 100644
--- a/_headers
+++ b/_headers
@@ -20,3 +20,16 @@
   X-Robots-Tag: noindex, nofollow
 /tools/*
   X-Robots-Tag: noindex, nofollow
+
+# Security headers on every page.
+# - nosniff: browsers must not guess a different content type.
+# - SAMEORIGIN: other sites cannot put this site in a frame (clickjacking).
+# - Referrer-Policy: other sites only see the domain, not the full address.
+# - Permissions-Policy: switch off browser features the site never uses.
+# - HSTS: browsers remember to use HTTPS for a year.
+/*
+  X-Content-Type-Options: nosniff
+  X-Frame-Options: SAMEORIGIN
+  Referrer-Policy: strict-origin-when-cross-origin
+  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
+  Strict-Transport-Security: max-age=31536000
diff --git a/netlify/functions/booking-email-status.js b/netlify/functions/booking-email-status.js
index 3625f24..b9fc177 100644
--- a/netlify/functions/booking-email-status.js
+++ b/netlify/functions/booking-email-status.js
@@ -62,8 +62,26 @@ const SAMPLE_BOOKING_DATA = {
   flight_number: "OU491",
 };
 
+// Access control. This URL is public, and ?sendTestTo= makes the site send a
+// real email from the business domain through Resend, so anyone who found it
+// could use it to send mail to any address. It is therefore off unless
+// BOOKING_STATUS_TOKEN is set in the Netlify environment, and every call must
+// then carry ?token=<the same value>. Without a match it answers like a page
+// that does not exist.
+const crypto = require("crypto");
+function tokenOk(given) {
+  const expected = process.env.BOOKING_STATUS_TOKEN;
+  if (!expected || typeof given !== "string" || !given) return false;
+  const a = Buffer.from(given);
+  const b = Buffer.from(expected);
+  return a.length === b.length && crypto.timingSafeEqual(a, b);
+}
+
 exports.handler = async (event) => {
   const params = event.queryStringParameters || {};
+  if (!tokenOk(params.token)) {
+    return { statusCode: 404, headers: { "Content-Type": "text/plain" }, body: "Not found" };
+  }
   const wantsResendCheck = Boolean(params.checkResend);
   const sendTestTo = params.sendTestTo;
   const useFullTemplate = Boolean(params.fullTemplate);

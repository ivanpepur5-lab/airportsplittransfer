+      <ul class="trip-highlights" style="margin-bottom:32px;">
+        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Ingen delt shuttle, rett til adressen din</li>

/assets/*
  Cache-Control: public, max-age=604800, must-revalidate

# JS and CSS change together with the HTML partials on every deploy and
# aren't fingerprinted, so browsers must revalidate them on each load
# (a cheap 304 when unchanged). A 1-hour max-age here let a cached old
# booking-widget.js run against a freshly deployed form and crash it.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Working files that live in the repo but are not part of the site
# (article drafts, the GBP post log, build tools): served if someone has
# the URL, but kept out of search results.
/content-pipeline/*
  X-Robots-Tag: noindex, nofollow
/marketing/*
  X-Robots-Tag: noindex, nofollow
/tools/*
  X-Robots-Tag: noindex, nofollow
